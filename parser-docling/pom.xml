<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.infinityknowledge</groupId>
        <artifactId>infinity-knowledge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>parser-docling</artifactId>
    <name>Infinity Knowledge :: Parser :: Docling</name>

    <properties>
        <!-- 官方文档曾展示 0.5.4，但该版本未发布到 Maven Central；固定使用可解析的 0.5.3。 -->
        <docling-java.version>0.5.3</docling-java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.infinityknowledge</groupId>
            <artifactId>knowledge-ingestion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.docling</groupId>
            <artifactId>docling-serve-client</artifactId>
            <version>${docling-java.version}</version>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Docling 0.5.3 同时发布 Jackson 2/3 注解；Werror 编译需要两套注解类型可见。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
