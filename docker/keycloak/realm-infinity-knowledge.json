{
  "realm": "infinity-knowledge",
  "enabled": true,
  "displayName": "Infinity Knowledge",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "knowledge-reader",
        "description": "读取已授权知识空间"
      },
      {
        "name": "knowledge-admin",
        "description": "管理租户知识空间与连接器"
      }
    ]
  },
  "clients": [
    {
      "clientId": "infinity-knowledge-console",
      "name": "Infinity Knowledge Console",
      "description": "Browser SPA client for the local management console",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "departments",
            "claim.name": "departments",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "infinity-knowledge-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "infinity-knowledge-cli",
      "name": "Infinity Knowledge CLI",
      "description": "Direct access grant client for local API verification",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "departments",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "departments",
            "claim.name": "departments",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "infinity-knowledge-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "infinity-knowledge-api",
      "name": "Infinity Knowledge API",
      "description": "Bearer-only resource server for the Infinity Knowledge API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "demo-reader",
      "enabled": true,
      "email": "demo-reader@example.invalid",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Reader",
      "attributes": {
        "departments": [
          "engineering"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "demo-reader",
          "temporary": false
        }
      ],
      "realmRoles": [
        "knowledge-reader"
      ]
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "email": "demo-admin@example.invalid",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "attributes": {
        "departments": [
          "engineering"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "demo-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "knowledge-reader",
        "knowledge-admin"
      ]
    }
  ]
}
